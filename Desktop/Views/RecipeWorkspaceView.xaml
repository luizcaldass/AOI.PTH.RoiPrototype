<UserControl x:Class="AOI.PTH.Desktop.Views.RecipeWorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:AOI.PTH.Desktop.Controls">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Trocar receita" Command="{Binding Navigate}" CommandParameter="1" Margin="0,0,8,0"/><Button Content="Carregar foto de teste…" Command="{Binding LoadTestPhoto}" Style="{StaticResource PrimaryButton}"/></StackPanel><StackPanel><TextBlock Text="RECEITA ATIVA • TESTE POR IMAGENS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding ActiveRecipeLabel}" FontSize="16" FontWeight="SemiBold"/></StackPanel></DockPanel></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition Width="265"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><controls:RoiImageView Source="{Binding RecipeImage}" Rois="{Binding ActiveRois}" Selected="{Binding SelectedActiveRoi}" MinHeight="240"/><TextBlock Grid.Row="1" Text="{Binding PhotoStatus}" Style="{StaticResource MutedText}" Margin="0,12,0,0"/></Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="ROIs da receita" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <ListBox Grid.Row="1" ItemsSource="{Binding ActiveRois}" SelectedItem="{Binding SelectedActiveRoi}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5"><TextBlock Text="{Binding Reference}" FontWeight="SemiBold"/><TextBlock FontSize="10" Foreground="{StaticResource Muted}"><Run Text="X: "/><Run Text="{Binding X, Mode=OneWay}"/><Run Text="  Y: "/><Run Text="{Binding Y, Mode=OneWay}"/><Run Text="  Ativa: "/><Run Text="{Binding Enabled, Mode=OneWay}"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    <StackPanel Grid.Row="2" Margin="0,14,0,10"><TextBlock Text="REFERÊNCIA LIMPA" Style="{StaticResource Eyebrow}"/><Image Source="{Binding CleanReference}" Height="95" Stretch="Uniform"/></StackPanel>
    <StackPanel Grid.Row="3"><TextBlock Text="REFERÊNCIA MONTADA" Style="{StaticResource Eyebrow}"/><Image Source="{Binding AssembledReference}" Height="95" Stretch="Uniform"/></StackPanel>
   </Grid></Border>
  </Grid>
  <Border Grid.Row="2" Background="#FFF3DC" Padding="12" Margin="0,14,0,0" CornerRadius="5"><DockPanel><Button DockPanel.Dock="Right" Content="Voltar à demonstração" Command="{Binding ResetDemo}" Margin="14,0,0,0"/><TextBlock Text="Receita real carregada para conferir o alinhamento e as ROIs com fotos. Os scores de componentes, julgamento OK/NOK e contadores reais serão integrados depois." Foreground="#85540B" VerticalAlignment="Center"/></DockPanel></Border>
 </Grid>
</UserControl>
