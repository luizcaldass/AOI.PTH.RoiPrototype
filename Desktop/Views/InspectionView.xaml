<UserControl x:Class="AOI.PTH.Desktop.Views.InspectionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AOI.PTH.Desktop.Controls">
 <Grid>
 <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel>
   <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="MODELO / RECEITA" Style="{StaticResource Eyebrow}"/><TextBlock Text="FONTE-24V · Rev. B" FontWeight="SemiBold" FontSize="15"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="PCI EM ANÁLISE / LOTE" Style="{StaticResource Eyebrow}"/><TextBlock Text="DEMO-0003  /  LOTE EXEMPLO" FontWeight="SemiBold"/></StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Carregar foto…" Command="{Binding Placeholder}" CommandParameter="Carregar foto" Margin="0,0,8,0"/><Button Content="Reiniciar demonstração" Command="{Binding ResetDemo}" Style="{StaticResource PrimaryButton}"/></StackPanel>
    </Grid>
   </Border>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="326"/></Grid.ColumnDefinitions>
    <StackPanel>
     <Border Style="{StaticResource Card}" Padding="0">
      <StackPanel>
       <Grid Margin="16,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Visão da PCI" FontWeight="SemiBold" FontSize="15"/><TextBlock Grid.Column="1" Text="ILUSTRAÇÃO • SEM ANÁLISE REAL" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center"/></Grid>
       <Border Background="#101F30" Padding="12"><local:BoardPreview Height="220" SelectedIndex="{Binding Selected.Index}" Mode="Board" AutomationProperties.Name="Ilustração de placa com regiões JP3, R12 e C07. Selecione na lista de divergências."/></Border>
       <Grid Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CycleLabel}" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="■ ROI selecionada" FontSize="11" Foreground="#9B620C"/></Grid>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14">
      <StackPanel>
       <TextBlock Text="Comparação da região selecionada" FontWeight="SemiBold" Margin="0,0,0,12"/>
       <UniformGrid Columns="3">
        <StackPanel Margin="0,0,8,0"><Border Background="#122738" CornerRadius="4" Padding="6"><local:BoardPreview Height="88" Mode="Reference" SelectedIndex="{Binding Selected.Index}"/></Border><TextBlock Text="Referência montada" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
        <StackPanel Margin="0,0,8,0"><Border Background="#122738" CornerRadius="4" Padding="6"><local:BoardPreview Height="88" Mode="Current" SelectedIndex="{Binding Selected.Index}"/></Border><TextBlock Text="PCI em teste • exemplo" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
        <StackPanel><Border Background="#122738" CornerRadius="4" Padding="6"><local:BoardPreview Height="88" Mode="Difference" SelectedIndex="{Binding Selected.Index}"/></Border><TextBlock Text="Diferença • ilustração" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
       </UniformGrid>
      </StackPanel>
     </Border>
    </StackPanel>
    <StackPanel Grid.Column="2">
     <Border Style="{StaticResource Card}" Padding="16">
      <StackPanel><TextBlock Text="DIVERGÊNCIAS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding PendingLabel}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
       <ListBox ItemsSource="{Binding Components}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="9,8"/><Setter Property="Margin" Value="0,2"/></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Reference}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Decision}" FontSize="11"/></Grid></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
      <StackPanel>
       <TextBlock Text="{Binding Selected.Reference}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding Selected.Description}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,14"/>
       <Grid><TextBlock Text="Semelhança com presente" FontSize="11"/><TextBlock Text="{Binding Selected.Present, StringFormat={}{0}/100}" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid><ProgressBar Value="{Binding Selected.Present, Mode=OneWay}" Margin="0,7,0,12"/>
       <Grid><TextBlock Text="Semelhança com ausente" FontSize="11"/><TextBlock Text="{Binding Selected.Absent, StringFormat={}{0}/100}" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid><ProgressBar Value="{Binding Selected.Absent, Mode=OneWay}" Foreground="#C58220" Margin="0,7,0,12"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MARGEM" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Selected.Margin}" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="ÁREA ALTERADA" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Selected.Difference, StringFormat={}{0}%}" FontWeight="SemiBold"/></StackPanel></Grid>
       <TextBlock Text="Valores fictícios. Similaridade não é probabilidade de aprovação. Limites ainda não calibrados." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,12,0,14"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </Grid>
  </StackPanel>
 </ScrollViewer>
 <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0">
  <StackPanel>
   <TextBlock Text="{Binding Selected.Reference, StringFormat=JULGAMENTO DE {0} • SIMULAÇÃO}" Style="{StaticResource Eyebrow}"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal"><Button Content="Aceitável" Background="#E7F3EE" Foreground="#176349" BorderBrush="#BEDCCD" Command="{Binding Judge}" CommandParameter="Aceitável" Margin="0,0,8,0"/><Button Content="Confirmar defeito" Background="#FCECEB" Foreground="#A43436" BorderBrush="#EECBCD" Command="{Binding Judge}" CommandParameter="Defeito" Margin="0,0,8,0"/><Button Content="Cancelar julgamento" Command="{Binding CancelJudgment}" ToolTip="Retorna o rascunho selecionado para Pendente. Nada é apagado do banco."/></StackPanel>
    <Button Grid.Column="1" Content="Finalizar PCI • demo" Command="{Binding Finish}" Style="{StaticResource PrimaryButton}" ToolTip="Disponível depois de julgar as três regiões. Não registra produção real."/>
   </Grid>
  </StackPanel>
 </Border>
 </Grid>
</UserControl>
