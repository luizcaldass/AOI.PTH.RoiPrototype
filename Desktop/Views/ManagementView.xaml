<UserControl x:Class="AOI.PTH.Desktop.Views.ManagementView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Style><Style TargetType="UserControl"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></UserControl.Style>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid>
   <StackPanel>
    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <Border Style="{StaticResource Card}"><StackPanel>
     <DockPanel Margin="0,0,0,18"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Importar .aoireceita" Command="{Binding EditRecipe}" CommandParameter="Importar receita" Margin="0,0,8,0"/><Button Content="+ Nova receita" Command="{Binding EditRecipe}" CommandParameter="Criar receita" Style="{StaticResource PrimaryButton}"/></StackPanel><StackPanel><TextBlock Text="Biblioteca de modelos" Style="{StaticResource SectionTitle}"/><TextBlock Text="Exemplos de cadastro • nenhuma receita importada" Style="{StaticResource MutedText}"/></StackPanel></DockPanel>
     <DataGrid ItemsSource="{Binding Recipes}" SelectedIndex="0" MinHeight="160"><DataGrid.Columns><DataGridTextColumn Header="MODELO" Binding="{Binding Code}" Width="*"/><DataGridTextColumn Header="REVISÃO / VERSÃO" Binding="{Binding Revision}" Width="140"/><DataGridTextColumn Header="REGIÕES" Binding="{Binding Components}" Width="110"/><DataGridTextColumn Header="ESTADO" Binding="{Binding State}" Width="160"/></DataGrid.Columns></DataGrid>
     <WrapPanel Margin="0,16,0,0"><Button Content="Editar ROIs e referências" Command="{Binding EditRecipe}" CommandParameter="Editor de ROIs" Margin="0,0,8,8"/><Button Content="Validar versão" Command="{Binding EditRecipe}" CommandParameter="Validar receita" Margin="0,0,8,8"/><Button Content="Exportar pacote" Command="{Binding EditRecipe}" CommandParameter="Exportar receita" Margin="0,0,8,8"/></WrapPanel>
    </StackPanel></Border>
    <UniformGrid Columns="3" Margin="0,16,0,0">
     <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="01 / REFERÊNCIAS" Style="{StaticResource Eyebrow}"/><TextBlock Text="Limpa + montada" Style="{StaticResource SectionTitle}"/><TextBlock Text="Imagens do modelo, resolução e pontos para alinhamento." Style="{StaticResource MutedText}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="02 / COMPONENTES" Style="{StaticResource Eyebrow}"/><TextBlock Text="ROIs e critérios" Style="{StaticResource SectionTitle}"/><TextBlock Text="Nome, região, método e limites individuais por componente." Style="{StaticResource MutedText}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="03 / PUBLICAÇÃO" Style="{StaticResource Eyebrow}"/><TextBlock Text="Versão validada" Style="{StaticResource SectionTitle}"/><TextBlock Text="Receita revisada pela engenharia e preparada para importação." Style="{StaticResource MutedText}"/></StackPanel></Border>
    </UniformGrid>
    <TextBlock Text="Operador consulta. Engenharia e Administrador editam. A importação e o editor serão conectados na próxima etapa." Style="{StaticResource MutedText}" Margin="4,18"/>
   </StackPanel>
   <StackPanel>
    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="+ Tipo de defeito" Command="{Binding EditDefect}" Style="{StaticResource PrimaryButton}"/><StackPanel><TextBlock Text="Catálogo de defeitos" Style="{StaticResource SectionTitle}"/><TextBlock Text="Categorias iniciais propostas para o projeto" Style="{StaticResource MutedText}"/></StackPanel></DockPanel>
     <DataGrid ItemsSource="{Binding Defects}" MinHeight="235"><DataGrid.Columns><DataGridTextColumn Header="CÓDIGO" Binding="{Binding Code}" Width="90"/><DataGridTextColumn Header="DEFEITO" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="ANÁLISE PREVISTA" Binding="{Binding Method}" Width="200"/><DataGridTextColumn Header="DETECTOR" Binding="{Binding State}" Width="100"/></DataGrid.Columns></DataGrid>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Evidências por ocorrência" Style="{StaticResource SectionTitle}"/><TextBlock Text="Cada defeito confirmado será vinculado à PCI, ao componente, às imagens e ao operador responsável. Nesta versão não há ocorrências reais nem detectores ativos." Style="{StaticResource MutedText}" Margin="0,0,0,14"/><Button Content="Consultar exemplos de defeitos" HorizontalAlignment="Left" Command="{Binding Placeholder}" CommandParameter="Consultar evidências"/></StackPanel></Border>
   </StackPanel>
   <StackPanel>
    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="3"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Consultar inspeções" Style="{StaticResource SectionTitle}"/><TextBlock Text="Registros fictícios para avaliação do layout. Pesquisa e filtros ainda não conectados." Style="{StaticResource MutedText}" Margin="0,0,0,18"/>
     <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="Identificação da PCI ou lote" IsReadOnly="True" Foreground="{StaticResource Muted}" Margin="0,0,10,0" AutomationProperties.Name="Busca por PCI ainda não integrada"/><ComboBox Grid.Column="1" SelectedIndex="0" IsEnabled="False" Margin="0,0,10,0"><ComboBoxItem Content="Todos os resultados"/></ComboBox><Button Grid.Column="2" Content="Pesquisar" Command="{Binding Placeholder}" CommandParameter="Pesquisa no histórico" Style="{StaticResource PrimaryButton}"/></Grid>
     <DataGrid ItemsSource="{Binding History}" MinHeight="210"><DataGrid.Columns><DataGridTextColumn Header="PCI" Binding="{Binding Pci}" Width="110"/><DataGridTextColumn Header="MODELO" Binding="{Binding Model}" Width="*"/><DataGridTextColumn Header="HORÁRIO DEMO" Binding="{Binding Time}" Width="120"/><DataGridTextColumn Header="RESULTADO" Binding="{Binding Result}" Width="185"/><DataGridTextColumn Header="OPERADOR" Binding="{Binding Operator}" Width="135"/></DataGrid.Columns></DataGrid>
     <WrapPanel Margin="0,18,0,0"><Button Content="Abrir rastreabilidade" Command="{Binding Placeholder}" CommandParameter="Detalhes da inspeção" Margin="0,0,8,0"/><Button Content="Exportar relatório" Command="{Binding Placeholder}" CommandParameter="Exportar relatório"/></WrapPanel>
    </StackPanel></Border>
   </StackPanel>
   <StackPanel>
    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="4"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <TextBlock Text="VISÃO DA ESTAÇÃO • SEM DADOS REAIS" Style="{StaticResource Eyebrow}" Margin="0,0,0,14"/>
    <UniformGrid Columns="4">
     <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="PCIs únicas" Style="{StaticResource MutedText}"/><TextBlock Text="—" FontSize="36" Foreground="{StaticResource Brand}" Margin="0,10"/><TextBlock Text="Inspeções registradas" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Aprovadas" Style="{StaticResource MutedText}"/><TextBlock Text="—" FontSize="36" Foreground="#217455" Margin="0,10"/><TextBlock Text="Decisão final aceitável" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Reprovadas" Style="{StaticResource MutedText}"/><TextBlock Text="—" FontSize="36" Foreground="#AD4141" Margin="0,10"/><TextBlock Text="Defeito confirmado" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Pendentes" Style="{StaticResource MutedText}"/><TextBlock Text="—" FontSize="36" Foreground="#A47416" Margin="0,10"/><TextBlock Text="Revisão necessária" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></Border>
    </UniformGrid>
    <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="30"><StackPanel HorizontalAlignment="Center" Margin="0,35"><TextBlock Text="A produção aparecerá aqui" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Conectaremos os indicadores ao SQL Server na etapa de integração." Style="{StaticResource MutedText}" Margin="0,12" HorizontalAlignment="Center"/><TextBlock Text="Reinspeções terão vínculo com a mesma PCI e não aumentarão a contagem de placas únicas." Style="{StaticResource MutedText}" MaxWidth="470" TextAlignment="Center"/><Button Content="Configurar conexão" Command="{Binding Navigate}" CommandParameter="5" HorizontalAlignment="Center" Margin="0,24,0,0"/></StackPanel></Border>
   </StackPanel>
   <StackPanel>
    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="5"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Estação e servidor" Style="{StaticResource SectionTitle}"/><TextBlock Text="Formulário de demonstração. Não testa conexão nem armazena credenciais." Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
     <Grid IsEnabled="{Binding IsAdmin}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Servidor / instância SQL" Style="{StaticResource Eyebrow}"/><TextBox AutomationProperties.Name="Servidor SQL" ToolTip="Endereço a ser fornecido pela TI"/><TextBlock Text="Banco da AOI" Style="{StaticResource Eyebrow}" Margin="0,16,0,8"/><TextBox AutomationProperties.Name="Banco da AOI"/><TextBlock Text="Autenticação prevista" Style="{StaticResource Eyebrow}" Margin="0,16,0,8"/><ComboBox SelectedIndex="0" AutomationProperties.Name="Autenticação prevista"><ComboBoxItem Content="Windows / conta autorizada"/><ComboBoxItem Content="SQL Server / definir com a TI"/></ComboBox></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Pasta de evidências no servidor" Style="{StaticResource Eyebrow}"/><TextBox AutomationProperties.Name="Pasta de evidências"/><TextBlock Text="Pasta local de receitas" Style="{StaticResource Eyebrow}" Margin="0,16,0,8"/><TextBox Text="A definir na integração" IsReadOnly="True"/><TextBlock Text="Identificação da estação" Style="{StaticResource Eyebrow}" Margin="0,16,0,8"/><TextBox Text="ESTAÇÃO 01 — demonstração"/></StackPanel>
     </Grid><Button Content="Salvar configurações" Command="{Binding Configure}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,20,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Recursos e envio de dados" Style="{StaticResource SectionTitle}"/><TextBlock Text="Envio em segundo plano com fila persistente local, confirmação de recebimento e retenção de imagens. Limites de memória, disco e transferência serão definidos após medir o ThinkCentre." Style="{StaticResource MutedText}"/><TextBlock Text="SQL Server: não configurado   •   Sincronização: não integrada   •   Capacidade local: não medida" Foreground="{StaticResource Brand}" Margin="0,18,0,0" FontSize="11"/></StackPanel></Border>
   </StackPanel>
   <StackPanel>
    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="6"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="+ Cadastrar usuário" Command="{Binding ManageUsers}" Style="{StaticResource PrimaryButton}"/><StackPanel><TextBlock Text="Hierarquia de permissões" Style="{StaticResource SectionTitle}"/><TextBlock Text="Operador → Engenharia → Administrador" Style="{StaticResource MutedText}"/></StackPanel></DockPanel>
     <DataGrid ItemsSource="{Binding Permissions}" MinHeight="325"><DataGrid.Columns><DataGridTextColumn Header="AÇÃO" Binding="{Binding Action}" Width="*"/><DataGridTextColumn Header="OPERADOR" Binding="{Binding Operator}" Width="115"/><DataGridTextColumn Header="ENGENHARIA" Binding="{Binding Engineering}" Width="125"/><DataGridTextColumn Header="ADMINISTRADOR" Binding="{Binding Administrator}" Width="140"/></DataGrid.Columns></DataGrid>
    </StackPanel></Border>
    <Border Background="#FFF3DC" Padding="18" CornerRadius="6" Margin="0,16,0,0"><StackPanel><TextBlock Text="Seleção de perfil apenas para demonstração" Foreground="#85540B" FontWeight="SemiBold"/><TextBlock Text="Use o seletor no topo para verificar os botões permitidos em cada perfil. Não existe login, validação de identidade ou proteção de dados real nesta versão. A autorização será aplicada também nos serviços quando forem integrados." Foreground="#85540B" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
   </StackPanel>
  </Grid>
 </ScrollViewer>
</UserControl>
