<Window x:Class="AOI.PTH.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:AOI.PTH.Desktop.Views"
 Title="AOI PTH | Estação de inspeção — protótipo" Width="1440" Height="1040" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen"
 FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Ink}" Background="#F2F5F9">
 <Grid x:Name="Surface" Background="#F2F5F9">
  <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
   <Grid Margin="24,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="198"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="Panasonic" Foreground="{StaticResource Brand}" FontSize="26" FontWeight="Bold"/><TextBlock Text="AOI  /  INSPEÇÃO PTH" FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Background="#E8F0FA" Padding="10,5" CornerRadius="4"><TextBlock Text="ESTAÇÃO 01" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Brand}"/></Border>
     <Menu Background="Transparent" VerticalAlignment="Center" Margin="18,0,0,0">
      <MenuItem Header="_Arquivo" Padding="10,6">
       <MenuItem Header="Importar receita .aoireceita…" Command="{Binding EditRecipe}" CommandParameter="Importar receita"/>
       <MenuItem Header="Exportar receita…" Command="{Binding EditRecipe}" CommandParameter="Exportar receita"/>
       <Separator/><MenuItem Header="Sair" Click="ExitClick"/>
      </MenuItem>
      <MenuItem Header="_Ajuda" Padding="10,6"><MenuItem Header="Sobre esta demonstração" Command="{Binding Placeholder}" CommandParameter="Ajuda e manual"/></MenuItem>
     </Menu>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="PERFIL DEMO" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,10,0"/>
     <ComboBox Width="158" ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" AutomationProperties.Name="Perfil de demonstração" ToolTip="Alternância apenas para testar a interface. Não há autenticação real."/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#082B56">
    <DockPanel Margin="12,22,12,18">
     <StackPanel DockPanel.Dock="Bottom" Margin="12,0">
      <Border Background="#163D69" CornerRadius="6" Padding="12"><StackPanel><TextBlock Text="PROTÓTIPO DE INTERFACE" FontSize="10" Foreground="#B8D5F7" FontWeight="SemiBold"/><TextBlock Text="Fotos • operação offline" Foreground="White" FontSize="12" Margin="0,6,0,0"/><TextBlock Text="Sem câmera ou conexão SQL" Foreground="#B8CBE1" FontSize="10" Margin="0,4,0,0"/></StackPanel></Border>
      <TextBlock Text="AOI PTH  /  v0.3" Foreground="#91ABC9" FontSize="10" Margin="0,18,0,0"/>
     </StackPanel>
     <TextBlock DockPanel.Dock="Top" Text="ÁREA DE TRABALHO" Foreground="#91ABC9" FontSize="10" FontWeight="SemiBold" Margin="14,0,0,14"/>
     <ListBox ItemsSource="{Binding Navigation}" SelectedIndex="{Binding Page}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Top">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
       <Setter Property="Foreground" Value="#C4D3E6"/><Setter Property="Padding" Value="14,13"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Bg" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Bg" Property="Background" Value="#174B85"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="BorderBrush" Value="#4A709A"/><Setter TargetName="Bg" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      </Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Width="30" VerticalAlignment="Center" FontSize="16"/><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1" Margin="24,20,24,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="{Binding Title}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
     <Border Grid.Column="1" Background="#FFF3DC" CornerRadius="5" Padding="10,6" VerticalAlignment="Top" Margin="12,5,0,0"><TextBlock Text="TESTES OFFLINE • PERFIS DEMO" Foreground="#85540B" FontSize="10" FontWeight="SemiBold"/></Border>
    </Grid>
    <Border Grid.Row="1" Background="#E8F0FA" CornerRadius="5" Padding="12,8" Margin="0,0,0,16"><TextBlock Text="{Binding RoleNotice}" Foreground="{StaticResource Brand}" FontSize="11"/></Border>
    <Grid Grid.Row="2">
     <views:InspectionView><views:InspectionView.Style><Style TargetType="views:InspectionView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Page}" Value="0"/><Condition Binding="{Binding ShowDemo}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></views:InspectionView.Style></views:InspectionView>
     <views:RecipeWorkspaceView Visibility="{Binding ShowRecipeWorkspace, Converter={StaticResource BoolVisibility}}"/>
     <views:ManagementView/>
    </Grid>
    <Border Grid.Row="3" BorderThickness="3,0,0,0" BorderBrush="#6999CE" Background="#EAF0F7" Padding="10,8" Margin="0,12,0,0"><TextBlock Text="{Binding Notice}" FontSize="11" Foreground="#385778" AutomationProperties.LiveSetting="Polite"/></Border>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="●  SQL Server: não configurado     |     Envios: não integrados     |     Disco: não monitorado" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="1" Text="{Binding ActiveRecipeLabel}" MaxWidth="420" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{StaticResource Brand}" VerticalAlignment="Center"/>
   </Grid>
  </Border>
 </Grid>
</Window>
