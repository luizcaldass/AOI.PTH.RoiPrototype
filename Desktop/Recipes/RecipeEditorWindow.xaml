<Window x:Class="AOI.PTH.Desktop.Recipes.RecipeEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:AOI.PTH.Desktop.Controls"
 Title="Receita por imagens • AOI PTH" Width="1240" Height="900" MinWidth="1050" MinHeight="740" WindowStartupLocation="CenterOwner"
 FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Ink}" Background="#F2F5F9" Closing="OnClosing">
 <Grid Margin="20" Background="#F2F5F9">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Criar / revisar receita" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Fotos PNG/JPEG • coordenadas na referência limpa • sem câmera" Style="{StaticResource MutedText}" Margin="0,4,0,16"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding VersionLabel}" Foreground="{StaticResource Brand}" VerticalAlignment="Center"/></Grid>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="14">
   <StackPanel IsEnabled="{Binding Ready}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,12,0"><TextBlock Text="MODELO / CÓDIGO" Style="{StaticResource Eyebrow}"/><TextBox Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Modelo da placa"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="REVISÃO DA PCI" Style="{StaticResource Eyebrow}"/><TextBox Text="{Binding Revision, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" AutomationProperties.Name="Revisão da placa"/></StackPanel>
     <StackPanel Grid.Column="2" Margin="0,0,12,0"><Button Content="1. Foto da placa limpa…" Click="ChooseClean"/><TextBlock Text="{Binding CleanLabel}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
     <StackPanel Grid.Column="3"><Button Content="2. Foto da placa montada…" Click="ChooseAssembled"/><TextBlock Text="{Binding AssembledLabel}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
    </Grid>
    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="115"/><ColumnDefinition Width="95"/><ColumnDefinition Width="95"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,10,0"><TextBlock Text="THRESHOLD" Style="{StaticResource Eyebrow}"/><TextBox Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="ÁREA MÍN. (PX²)" Style="{StaticResource Eyebrow}"/><TextBox Text="{Binding MinArea, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
     <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="MARGEM (PX)" Style="{StaticResource Eyebrow}"/><TextBox Text="{Binding Padding, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
     <StackPanel Grid.Column="3"><TextBlock Text="UNIÃO (PX)" Style="{StaticResource Eyebrow}"/><TextBox Text="{Binding MergeDistance, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
     <TextBlock Grid.Column="4" Text="Gerar novamente substitui as ROIs deste rascunho. Ajuste os parâmetros com as suas fotos." Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="16,0"/>
     <Button Grid.Column="5" Content="3. Alinhar e gerar ROIs" Style="{StaticResource PrimaryButton}" Click="Generate" VerticalAlignment="Bottom"/>
    </Grid>
   </StackPanel>
  </Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,10"><TextBlock Text="Referência montada alinhada" FontWeight="SemiBold"/><CheckBox DockPanel.Dock="Right" Content="Desenhar ROI" IsChecked="{Binding Drawing}" IsEnabled="{Binding HasPrepared}" HorizontalAlignment="Right"/></DockPanel>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#101F30"><controls:RoiImageView x:Name="ImageCanvas" Source="{Binding Preview}" Rois="{Binding Rois}" Selected="{Binding Selected}" Width="700" Height="400"><controls:RoiImageView.LayoutTransform><ScaleTransform ScaleX="{Binding Value, ElementName=Zoom}" ScaleY="{Binding Value, ElementName=Zoom}"/></controls:RoiImageView.LayoutTransform></controls:RoiImageView></ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="Zoom" VerticalAlignment="Center"/><Slider x:Name="Zoom" Minimum="0.5" Maximum="3" Value="0.8" Width="140" Margin="12,0"/><TextBlock Text="Arraste para criar. Edite posição e tamanho na tabela." FontSize="11" Foreground="{StaticResource Muted}" MaxWidth="330"/></StackPanel>
   </Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12"><Grid IsEnabled="{Binding Ready}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="ROIs • nomes e coordenadas editáveis" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <DataGrid x:Name="RoiGrid" Grid.Row="1" ItemsSource="{Binding Rois}" SelectedItem="{Binding Selected}" IsReadOnly="False" CanUserSortColumns="False" RowHeight="34" CellEditEnding="RoiEdited" SelectionUnit="FullRow">
     <DataGrid.Resources><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="4"/></Style><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="4,10"/></Style></DataGrid.Resources>
     <DataGrid.Columns><DataGridCheckBoxColumn Header="Ativa" Binding="{Binding Enabled}" Width="50"/><DataGridTextColumn Header="Nome" Binding="{Binding Reference}" Width="80"/><DataGridTextColumn Header="X" Binding="{Binding X, ValidatesOnExceptions=True}" Width="50"/><DataGridTextColumn Header="Y" Binding="{Binding Y, ValidatesOnExceptions=True}" Width="50"/><DataGridTextColumn Header="L" Binding="{Binding Width, ValidatesOnExceptions=True}" Width="50"/><DataGridTextColumn Header="A" Binding="{Binding Height, ValidatesOnExceptions=True}" Width="50"/></DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="2"><Button Content="Remover ROI selecionada" Click="RemoveRoi" IsEnabled="{Binding HasPrepared}" Margin="0,12,0,8"/><TextBlock Text="Todas as medidas são pixels da referência limpa. L = largura; A = altura. As ROIs são candidatas: revise regiões unidas e componentes pequenos." Style="{StaticResource MutedText}"/></StackPanel>
   </Grid></Border>
  </Grid>
  <Border Grid.Row="3" Background="#E8F0FA" Padding="12" CornerRadius="5" Margin="0,14,0,12"><TextBlock Text="{Binding Message}" Foreground="{StaticResource Brand}"/></Border>
  <Grid Grid.Row="4" IsEnabled="{Binding Ready}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <CheckBox Content="Revisei as ROIs para os testes offline (não libera produção)." IsChecked="{Binding Reviewed}" VerticalAlignment="Center"/>
   <Button Grid.Column="1" Content="Cancelar" Click="Cancel" Margin="10,0"/><Button Grid.Column="2" Content="Salvar receita local" Click="Save" IsEnabled="{Binding HasPrepared}" Style="{StaticResource PrimaryButton}"/>
  </Grid>
 </Grid>
</Window>
